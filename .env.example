# Optional: enables the Gemini LLM analyst (heuristic fallbacks otherwise)
GEMINI_API_KEY=your_gemini_api_key

# Optional: authenticated Coinbase endpoints (public data otherwise)
COINBASE_API_KEY=your_coinbase_api_key

# Required in production: Stripe paywall
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: server port (Render sets this automatically)
PORT=3000
